          "value": "POST"
        },
        {
          "name": "headers",
          "value": "Content-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"data\": {\"hash_sha256\": \"$exec.all_fields.data.hash_sha256\", \"sha256\": \"$exec.all_fields.data.sha256\", \"win\": {\"eventdata\": {\"hashes\": \"$exec.all_fields.data.win.eventdata.hashes\"}}}, \"syscheck\": {\"sha256_after\": \"$exec.all_fields.syscheck.sha256_after\"}}"
        },
        {
          "name": "verify",
          "value": "false"
        },
        {
          "name": "timeout",
          "value": "90"
        }
      ],
      "position": {
        "x": -250,
        "y": 0
