{
  "name": "SOC FileDrop Triage",
  "description": "Collected dropped file -> /analyze-file (content YARA) + hash analyzers -> risk engine -> isolate-agent if score>=75",
  "start": "action_create_thehive_alert",
  "tags": [
    "soc",
    "scenario",
    "filedrop",
    "wazuh",
    "thehive",
    "cortex",
    "misp",
    "yara"
  ],
