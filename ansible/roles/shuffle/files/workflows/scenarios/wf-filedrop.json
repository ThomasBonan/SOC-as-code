      "id": "action_create_thehive_alert",
      "label": "action_create_thehive_alert",
      "app_name": "http",
      "app_version": "1.4.0",
      "name": "POST",
      "parameters": [
        {
          "name": "url",
          "value": "$ENV_THEHIVE_URL/api/v1/alert"
        },
        {
          "name": "method",
          "value": "POST"
        },
        {
          "name": "headers",
          "value": "Authorization: Bearer $ENV_THEHIVE_APIKEY\nContent-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"title\": \"[FILEDROP] $exec.all_fields.rule.description\", \"type\": \"External\", \"source\": \"wazuh\", \"sourceRef\": \"wazuh-$exec.all_fields.agent.id-$exec.all_fields.rule.id-$exec.all_fields.timestamp\", \"description\": \"Agent: $exec.all_fields.agent.name ($exec.all_fields.agent.ip) | Rule: $exec.all_fields.rule.id | Level: $exec.all_fields.rule.level | Scenario: filedrop\", \"severity\": 3, \"tags\": [\"source:wazuh\", \"scenario:filedrop\", \"agent:$exec.all_fields.agent.name\", \"rule:$exec.all_fields.rule.id\"]}"
        },
        {
          "name": "verify",
          "value": "false"
        },
        {
          "name": "timeout",
          "value": "90"
        }
      ],
      "position": {
        "x": -400,
        "y": 0
      }
    },
    {
