      "parameters": [
        {
          "name": "url",
          "value": "$ENV_WAZUH_API_URL/security/user/authenticate"
        },
        {
          "name": "method",
          "value": "POST"
        },
        {
          "name": "headers",
          "value": "Authorization: Basic $ENV_WAZUH_B64AUTH"
        },
        {
          "name": "verify",
          "value": "false"
        },
        {
          "name": "timeout",
          "value": "60"
        }
      ],
      "position": {
        "x": -100,
        "y": -150
      }
    },
    {
