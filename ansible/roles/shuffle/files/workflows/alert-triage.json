{
  "name": "SOC Alert Triage",
  "description": "Generic fallback: Wazuh -> normalize -> risk engine (behavioral floor) -> TheHive (linear, deadlock-proof)",
  "start": "action_create_thehive_alert",
  "tags": [
    "soc",
    "triage",
    "fallback",
    "wazuh",
    "thehive"
  ],
  "actions": [
    {
      "id": "action_create_thehive_alert",
      "label": "action_create_thehive_alert",
      "app_name": "http",
      "app_version": "1.4.0",
      "name": "POST",
      "parameters": [
        {
          "name": "url",
          "value": "$ENV_THEHIVE_URL/api/v1/alert"
        },
        {
          "name": "method",
          "value": "POST"
        },
        {
          "name": "headers",
          "value": "Authorization: Bearer $ENV_THEHIVE_APIKEY\nContent-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"title\": \"[TRIAGE] $exec.all_fields.rule.description\", \"type\": \"External\", \"source\": \"wazuh\", \"sourceRef\": \"wazuh-$exec.all_fields.agent.id-$exec.all_fields.rule.id-$exec.all_fields.timestamp\", \"description\": \"Agent: $exec.all_fields.agent.name ($exec.all_fields.agent.ip) | Rule: $exec.all_fields.rule.id | Level: $exec.all_fields.rule.level | Scenario: triage\", \"severity\": 2, \"tags\": [\"source:wazuh\", \"scenario:triage\", \"agent:$exec.all_fields.agent.name\", \"rule:$exec.all_fields.rule.id\"]}"
        },
        {
          "name": "verify",
          "value": "false"
        },
        {
          "name": "timeout",
          "value": "90"
        }
      ],
      "position": {
        "x": -400,
        "y": 0
      }
    },
    {
      "id": "action_normalize",
      "label": "action_normalize",
      "app_name": "http",
      "app_version": "1.4.0",
      "name": "POST",
      "parameters": [
        {
          "name": "url",
          "value": "$ENV_RISK_ENGINE_URL/normalize"
        },
        {
          "name": "method",
          "value": "POST"
        },
        {
          "name": "headers",
          "value": "Content-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"data\": {\"hash_sha256\": \"$exec.all_fields.data.hash_sha256\", \"srcip\": \"$exec.all_fields.data.srcip\", \"dstuser\": \"$exec.all_fields.data.dstuser\", \"win\": {\"eventdata\": {\"hashes\": \"$exec.all_fields.data.win.eventdata.hashes\", \"commandLine\": \"$exec.all_fields.data.win.eventdata.commandLine\"}}}}"
        },
        {
          "name": "verify",
          "value": "false"
        },
        {
          "name": "timeout",
          "value": "90"
        }
      ],
      "position": {
        "x": -200,
        "y": 0
      }
    },
    {
      "id": "action_call_risk_engine",
      "label": "action_call_risk_engine",
      "app_name": "http",
      "app_version": "1.4.0",
      "name": "POST",
      "parameters": [
        {
          "name": "url",
          "value": "$ENV_RISK_ENGINE_URL/score"
        },
        {
          "name": "method",
          "value": "POST"
        },
        {
          "name": "headers",
          "value": "Content-Type: application/json"
        },
        {
          "name": "body",
          "value": "{\"case_id\": \"$action_create_thehive_alert.body._id\", \"wazuh_severity\": \"$exec.all_fields.rule.level\", \"agent_name\": \"$exec.all_fields.agent.name\", \"asset_type\": \"$exec.all_fields.agent.labels.type\", \"scenario\": \"triage\", \"frequency\": 1, \"environment\": \"$ENV_SOC_ENVIRONMENT\", \"command_line\": \"$action_normalize.body.command_line\"}"
        },
        {
          "name": "verify",
          "value": "false"
        },
        {
          "name": "timeout",
          "value": "90"
        }
      ],
      "position": {
        "x": 400,
        "y": 0
      }
    },
